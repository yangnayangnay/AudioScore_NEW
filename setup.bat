@echo off
setlocal enabledelayedexpansion
title MuScriptor Setup
REM Route all auto-downloads through the China mirror
set "HF_ENDPOINT=https://hf-mirror.com"
REM If MuScriptor/assets is ever gated, create a token at
REM huggingface.co/settings/tokens and uncomment the next line:
REM set "HF_TOKEN=hf_xxxxxxxxxxxxxxxx"
cd /d "%~dp0"

echo ==================================================
echo  MuScriptor Setup
echo  [1/4] Python venv
echo  [2/4] Dependencies: basic-pitch + muscriptor
echo  [3/4] MuScriptor-LARGE weights (5.4 GB, CN mirror, resumable)
echo  [4/4] BeatThis checkpoint + soundfonts (CN mirror, resumable)
echo ==================================================

set "PY=python"
%PY% --version >nul 2>&1 || set "PY=py -3"
%PY% --version >nul 2>&1 || (
    echo [ERROR] Python not found. Install Python 3.10+ then re-run.
    pause & exit /b 1
)

echo [1/4] Virtual environment...
if not exist ".venv\Scripts\python.exe" %PY% -m venv .venv
call ".venv\Scripts\activate.bat"

echo [2/4] Installing dependencies...
python -m pip install --upgrade pip -q
python -m pip install -q -U basic-pitch muscriptor
if errorlevel 1 (
    echo [ERROR] pip install failed. Check network and re-run.
    pause & exit /b 1
)
echo [OK] basic-pitch + muscriptor ready.

set "MODEL_DIR=%~dp0models\muscriptor-large"
set "BASE_URL=https://hf-mirror.com/cocktailpeanut/muscriptor-large/resolve/main"
if not exist "%MODEL_DIR%" mkdir "%MODEL_DIR%"

echo [2.5/4] Upgrading torch to CUDA build for the RTX 4070...
python -m pip install -q --upgrade --force-reinstall torch torchaudio --index-url https://download.pytorch.org/whl/cu128

echo [3/4] Downloading MuScriptor-LARGE weights...
echo Source: %BASE_URL%/model.safetensors
echo If interrupted, just re-run setup.bat - it resumes.
if not exist "%MODEL_DIR%\config.json" (
    curl -fL --retry 5 --retry-delay 3 --connect-timeout 30 -o "%MODEL_DIR%\config.json" "%BASE_URL%/config.json"
    if errorlevel 1 echo [WARN] config.json failed, re-run setup.bat later.
)
set /a TRIES=0
:download_weights
set "SIZE_MB=0"
for /f %%A in ('powershell -NoProfile -Command "[math]::Round((Get-Item -LiteralPath '%MODEL_DIR%\model.safetensors' -ErrorAction SilentlyContinue).Length/1MB)"') do set "SIZE_MB=%%A"
if !SIZE_MB! GEQ 5200 goto weights_done
set /a TRIES+=1
if !TRIES! GTR 6 (
    echo [ERROR] Download incomplete after several attempts.
    echo Re-run setup.bat later - it resumes from the breakpoint.
    pause & exit /b 1
)
echo Progress: !SIZE_MB! MB / ~5215 MB - downloading...
curl -fL --retry 5 --retry-delay 3 --connect-timeout 30 -C - -o "%MODEL_DIR%\model.safetensors" "%BASE_URL%/model.safetensors"
goto download_weights
:weights_done
echo [OK] Weights ready: !SIZE_MB! MB

REM ---------- [4/4] Preload BeatThis checkpoint + soundfonts into the
REM HF cache. muscriptor loads hf://MuScriptor/assets/beat_this-final0.ckpt
REM at runtime; a cache hit = it works fully offline. Auto-resumes.
set "ASSETS_REPO=MuScriptor/assets"
echo [4/4] Preloading BeatThis checkpoint + soundfonts from %ASSETS_REPO% ...
echo ^(skips automatically if already cached^)
set /a ATRIES=0
:download_assets
set /a ATRIES+=1
if %ATRIES% GTR 4 (
    echo [ERROR] Assets download failed after several attempts.
    echo Re-run setup.bat later - it resumes from the breakpoint.
    pause & exit /b 1
)
echo Attempt %ATRIES%/4 ...
python -c "from huggingface_hub import snapshot_download; p=snapshot_download('%ASSETS_REPO%'); print('[OK] assets cached at:', p)"
if errorlevel 1 (
    timeout /t 5 /nobreak >nul
    goto download_assets
)
echo [OK] BeatThis + soundfonts cached. The runtime can now run fully offline.

REM FIX (important): "model:" MUST be indented 2 spaces under "muscriptor:"
REM or config.py crashes with 'NoneType' object has no attribute 'get'.
set "CFG_MODEL=%MODEL_DIR:\=/%"
(
    echo # Auto-generated by setup.bat. Re-running setup overwrites this file.
    echo engine: basic_pitch
    echo muscriptor:
    echo   model: !CFG_MODEL!/model.safetensors
) > config.yaml

echo.
echo [DONE] All models preloaded. Runtime needs NO network access.
echo Run start.bat, then open http://localhost:8000
echo Keep  set HF_HUB_OFFLINE=1  in start.bat for guaranteed offline mode.
pause
